# Copiar a .env y completar. Nunca commitear .env.

# Aplicación
APP_HOST=127.0.0.1
APP_PORT=8765
APP_ENV=local
APP_PASSWORD=
SESSION_SECRET=cambiar-por-un-valor-largo-y-aleatorio

# Datos locales. Vacío usa el directorio estándar del sistema operativo.
APP_DATA_DIR=

# Google AI Studio / Gemini
# Si GEMINI_API_KEY está exportada en tu shell, puede tener prioridad sobre .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CV_EXTRACTION=true
GEMINI_JOB_EXTRACTION=false

# LinkedIn MCP
LINKEDIN_MCP_VERSION=4.28.0
LINKEDIN_HEADLESS=true
LINKEDIN_TOOL_TIMEOUT=300

# Automatización Easy Apply
APPLY_HEADLESS=false
APPLY_DRY_RUN=true
APPLY_LIVE_SUBMIT=false
APPLY_MAX_STEPS=8
APPLY_ACTION_DELAY_MS=700
APPLY_ACTION_DELAY_JITTER_MS=500
APPLY_HUMAN_TYPING=true
REMOTE_ONLY=true

# Límites conservadores
DAILY_SCAN_LIMIT=1
DAILY_JOB_DETAIL_LIMIT=25
DAILY_APPLY_LIMIT=5
MCP_CALLS_PER_MINUTE=8
